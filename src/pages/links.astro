---
import Layout from '../layouts/Layout.astro';
import { links } from '../data/links.json';
---
<Layout title="Links" description="Where to find me and things worth keeping.">
  <section class="page-heading"><p class="eyebrow">Elsewhere</p><h1>Links</h1><p class="lead">Where to find me and things worth keeping.</p></section>
  <ul class="link-list">
    {links.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer"><span>{link.title}</span><span aria-hidden="true">↗</span></a>{link.description && <p>{link.description}</p>}</li>)}
  </ul>
</Layout>
